{
  "name": "dritchwear-mobile-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "EXPO_NO_TELEMETRY=1 expo start",
    "build:web": "expo export --platform web && node scripts/patch-pwa-head.js && cp vercel.json dist/vercel.json",
    "deploy": "npm run build:web && npx --no-install vercel link --yes --cwd dist --project dritchwear-webapp --scope dritchwear-2360s-projects && npx --no-install vercel deploy dist --prod --yes --scope dritchwear-2360s-projects",
    "lint": "expo lint",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.2.3",
