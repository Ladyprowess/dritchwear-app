{
  "expo": {
    "name": "Dritchwear",
    "slug": "dritchwear",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "dritchwear",
    "userInterfaceStyle": "automatic",
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#000000",
      "translucent": true
    },
    "androidNavigationBar": {
      "visible": "immersive",
      "backgroundColor": "#000000"
    },
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dritchwear.app",
      "associatedDomains": [
        "applinks:dritchwear.com",
        "applinks:www.dritchwear.com",
        "applinks:app.dritchwear.com"
      ],
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to upload logos.",
        "NSPhotoLibraryAddUsageDescription": "This app needs access to save logos to your photo library.",
        "NSCameraUsageDescription": "This app needs camera access to allow you take product or logo photos.",
        "NSUserNotificationsUsageDescription": "Allow Dritchwear to send you notifications about your orders, promotions, and important updates."
      }
    },
    "android": {
      "package": "com.dritchwear.app",
      "versionCode": 158,
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "dritchwear.com"
            },
            {
              "scheme": "https",
              "host": "www.dritchwear.com"
            },
            {
              "scheme": "https",
              "host": "app.dritchwear.com"
            }
          ]
        }
      ],
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "READ_MEDIA_AUDIO",
        "WRITE_EXTERNAL_STORAGE",
        "READ_EXTERNAL_STORAGE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-system-ui",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-localization",
      "expo-video",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#5A2D82",
          "sounds": [],
          "mode": "production"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableEdgeToEdge": false
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a4790542-c5a5-49ed-9721-562bb575964d"
      },
      "EXPO_PUBLIC_VTPASS_ENABLED": "true"
    },
    "owner": "ladyprow",
    "updates": {
      "url": "https://u.expo.dev/a4790542-c5a5-49ed-9721-562bb575964d"
    }
  }
}
